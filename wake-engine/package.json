{
  "name": "wake-engine",
  "version": "0.1.0",
  "description": "Non-custodial copy-trading SDK for Stellar/Soroban DEXs.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wake": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src cli test",
    "cli": "tsx cli/index.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
